<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Test'">
        <ProjectReference
            Include="..\Net10Sample.TestGenerator\Net10Sample.TestGenerator.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false" />
    </ItemGroup>

	<ItemGroup>		
		<ProjectReference Include="..\Net10Sample.TestProvider\Net10Sample.TestProvider.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="PriceCalculator.Nested.cs">
	    <DependentUpon>PriceCalculator.cs</DependentUpon>
	  </Compile>
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Test'">
		<DefineConstants>$(DefineConstants);TEST_EXPOSE</DefineConstants>
	</PropertyGroup>

</Project>


